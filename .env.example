DB_HOST=localhost
DB_PORT=5432
# Суперпользователь Postgres — только для контейнера db, приложение его не использует
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
# Пользователь приложения: владелец базы DB_NAME, без прав суперпользователя
DB_USER=expenses_app
DB_PASSWORD=
DB_NAME=server

# Ключ OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# auto — при запуске подобрать бесплатные модели. Можно перечислить свои через запятую.
LLM_MODEL=auto

BOT_TOKEN=
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
TZ=Europe/Moscow
