DB_HOST=localhost
DB_PORT=5432
# Суперпользователь Postgres — только для контейнера db, приложение его не использует
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
# Пользователь приложения: владелец базы DB_NAME, без прав суперпользователя
DB_USER=expenses_app
DB_PASSWORD=
DB_NAME=server

LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free

BOT_TOKEN=
HTTP_PORT=8080
TZ=Europe/Moscow
